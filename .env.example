# ==============================================================================
# AI Co-Pilot & FCOM RAG Assistant - Environment Configuration
# ==============================================================================

# LLM Configuration (OpenAI, OpenRouter, Groq, Ollama, Gemini OpenAI-compatible)
# Leave empty for deterministic extractive RAG fallback (no API key required)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Embedding Configuration
# Default: all-MiniLM-L6-v2 (or ONNX / chromadb default)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Vector Store Persistence
CHROMA_PERSIST_DIRECTORY=data/manuals/processed/chroma

# Voice & Speech Configuration
# STT options: browser (Web Speech API) or whisper
WHISPER_MODEL=base

# Application Settings
COPILOT_PORT=8000
COPILOT_HOST=127.0.0.1
DEBUG=true
